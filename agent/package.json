{
  "name": "cst-pilot",
  "version": "1.0.0",
  "description": "CST Pilot: portable diagnostics kit for the Computer Service Team, built on pi coding agent",
  "main": "index.js",
  "scripts": {
    "check": "biome check home/extensions && tsc --noEmit -p tsconfig.json",
    "test:web": "node --test home/extensions/web/test/*.test.ts",
    "format": "biome check --write home/extensions",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "typescript": "5.9.3"
  }
}
