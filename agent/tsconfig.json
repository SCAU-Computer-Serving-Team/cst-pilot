{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"erasableSyntaxOnly": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"skipLibCheck": true,
		"types": [
			"node"
		],
		"paths": {
			"@earendil-works/pi-tui": [
				"./node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-tui/dist/index.d.ts"
			],
			"@earendil-works/pi-ai": [
				"./node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-ai/dist/index.d.ts"
			],
			"typebox": [
				"./node_modules/@earendil-works/pi-coding-agent/node_modules/typebox/build/index.d.mts"
			],
			"typebox/value": [
				"./node_modules/@earendil-works/pi-coding-agent/node_modules/typebox/build/value/index.d.mts"
			]
		},
		"typeRoots": [
			"./node_modules/@types",
			"./node_modules/@earendil-works/pi-coding-agent/node_modules/@types"
		],
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": [
		"home/extensions/**/*.ts"
	]
}
